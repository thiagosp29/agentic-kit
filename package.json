{
  "name": "agentic-kit",
  "version": "0.1.0",
  "description": "Knowledge base, skills e agents para desenvolvimento assistido por IA — foco no Claude Code, compatível com qualquer IA via AGENTS.md.",
  "type": "module",
  "bin": {
    "agentic-kit": "dist/index.js"
  },
  "files": [
    "dist",
    "kit"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:kit": "node dist/index.js validate",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "ai",
    "claude",
    "claude-code",
    "agents",
    "skills",
    "agents-md",
    "clean-code"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
